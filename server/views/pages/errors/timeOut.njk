{% extends "partials/layout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "macros/title.njk" import getTitle with context %}

{% block pageTitle %}
  {{
    getTitle(
      null,
      null,
      null,
      __(titleIds.TIME_OUT)
    )
  }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if not production %}
        <h2>{{ status }}</h2>
        <pre>{{ stack }}</pre>
      {% endif %}

      {% set startAgainHref = paths.CHILDREN_SAFETY_CHECK %}
      {% if includeWelshLanguage and getLocale() == 'cy' %}
        {% set startAgainHref = paths.CHILDREN_SAFETY_CHECK ~ '?lang=cy' %}
      {% endif %}

      {% if isAuthenticated %}
        <h1>{{ __('errors.timeOut.authenticatedRoute.title') }}</h1>
        <p>{{ __('errors.timeOut.authenticatedRoute.yourSession') }}</p>
        <p>{{ __('errors.timeOut.authenticatedRoute.personalInformation') }}</p>
        <p>{{ __('errors.timeOut.authenticatedRoute.changesNotSaved') }}</p>
        {# TODO: This should be the GOV.UK One Login sign in page #}
        {{
          govukButton({
            text: __('errors.timeOut.authenticatedRoute.signInToContinue'),
            href: startAgainHref
          })
        }}
        <p>
          <a href="{{ startAgainHref }}" class="govuk-link">
            {{ __('errors.timeOut.authenticatedRoute.startNewPlan') }}
          </a>
        </p>
      {% else %}
        <h1>{{ __('errors.timeOut.unAuthenticatedRoute.title') }}</h1>
        <p>{{ __('errors.timeOut.unAuthenticatedRoute.yourSession') }}</p>
        <p>{{ __('errors.timeOut.unAuthenticatedRoute.personalInformation') }}</p>
        <p>{{ __('errors.timeOut.unAuthenticatedRoute.startAgain') }}</p>
        {{
          govukButton({
            text: __('errors.timeOut.unAuthenticatedRoute.startAgainButton'),
            href: startAgainHref
          })
        }}
      {% endif %}
    </div>
  </div>
{% endblock %}
