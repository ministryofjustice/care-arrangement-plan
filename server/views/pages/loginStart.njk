{% extends "partials/layout.njk" %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "macros/title.njk" import getTitle with context %}

{% block pageTitle %}
  {{
    getTitle(
      null,
      titleIds.LOGIN_START
    )
  }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {# {% include "partials/errorSummary.njk" %} #}

      <h1 class="govuk-heading-l">{{ __(loginStart.title) }}</h1>

      <p class="govuk-body">{{ __(loginStart.createAndDownload) }}</p>
      <p class="govuk-body">{{ __(loginStart.doNotSaveProgress) }}</p>
      <p class="govuk-body">{{ __(loginStart.saveProgress) }}</p>
      
      <h2 class="govuk-heading-m">{{ __(loginStart.question) }}</h2>

      <form class="form" action="{{ paths.LOGIN_START }}" method="post" novalidate>
        <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
        {{
          govukRadios({
            name: formFields.LOGIN_START,
            fieldset: {
              legend: {
                text: legendText,
                isPageHeading: true,
                classes: "govuk-fieldset__legend--l"
              }
            },
            hint: {
              html: additionalText
            },
            items: [
              {
                value: "Yes",
                text: __('loginStart.options.startNewPlan')
              },
              {
                value: "No",
                text: __('loginStart.options.signIn')
              }
            ],
            errorMessage: errors | findError(formFields.LOGIN_START)
          })
        }}
        {{ govukButton({text: __('continue')}) }}
      </form>
    </div>
  </div>
{% endblock %}