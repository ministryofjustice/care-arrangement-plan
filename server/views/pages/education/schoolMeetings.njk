{% extends "partials/layout.njk" %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/textarea/macro.njk" import govukTextarea %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "macros/title.njk" import getTitle with context %}

{% block pageTitle %}
  {{
    getTitle(
      errors,
      null,
      null,
      title
    )
  }}
{% endblock %}

{% block content %}
  {% include "partials/exitThisPage.njk" %}
  <div class="govuk-visually-hidden" role="status" aria-live="polite" aria-atomic="true">
    {{ __('exitThisPage') | safe }}
  </div>
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% include "partials/errorSummary.njk" %}
      <form class="form" action="{{ paths.EDUCATION_SCHOOL_MEETINGS }}" method="post" novalidate>
        <input type="hidden" name="_csrf" value="{{ csrfToken }}" />

        {% set describeArrangementHtml %}
          {{
            govukTextarea({
              name: formFields.EDUCATION_SCHOOL_MEETINGS_DESCRIBE_ARRANGEMENT,
              label: {
                text: __('describeArrangement')
              },
              value: formValues[formFields.EDUCATION_SCHOOL_MEETINGS_DESCRIBE_ARRANGEMENT],
              errorMessage: errors | findError(formFields.EDUCATION_SCHOOL_MEETINGS_DESCRIBE_ARRANGEMENT)
            })
          }}
        {% endset -%}

        {{
          govukRadios({
            name: formFields.EDUCATION_SCHOOL_MEETINGS_OPTION,
            fieldset: {
              legend: {
                text: title,
                isPageHeading: true,
                classes: "govuk-fieldset__legend--l"
              }
            },
            hint: {
              text: __('education.schoolMeetings.description')
            },
            items: [
              {
                value: "parent",
                text: __('education.schoolMeetings.options.parent')
              },
              {
                value: "otherParent",
                text: __('education.schoolMeetings.options.otherParent')
              },
              {
                value: "bothParents",
                text: __('education.schoolMeetings.options.bothParents')
              },
              {
                value: "carer",
                text: __('education.schoolMeetings.options.carer', { childName: childName })
              },
              {
                divider: __('or')
              },
              {
                value: "anotherArrangement",
                text: __('education.schoolMeetings.options.anotherArrangement'),
                conditional: {
                  html: describeArrangementHtml
                }
              }
            ],
            value: formValues[formFields.EDUCATION_SCHOOL_MEETINGS_OPTION],
            errorMessage: errors | findError(formFields.EDUCATION_SCHOOL_MEETINGS_OPTION)
          })
        }}
        <div class="govuk-!-margin-bottom-2">
          <button type="submit" name="skip" value="true" class="govuk-link link-styled-button">
            {{ __('skipThisQuestion') }}
          </button>
        </div>
        <div class="govuk-button-group">
          {{ govukButton({text: __('saveAndContinue')}) }}
          {{ govukButton({text: __('saveAndComeBackLater'), classes: "govuk-button--secondary"}) }}
        </div>
      </form>
    </div>
  </div>
{% endblock %}
