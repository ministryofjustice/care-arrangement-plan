{% extends "partials/layout.njk" %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "macros/title.njk" import getTitle with context %}

{% block pageTitle %}
  {{
    getTitle(
      errors,
      null,
      null,
      title
    )
  }}
{% endblock %}

{% block content %}
  {% include "partials/exitThisPage.njk" %}
  <div class="govuk-visually-hidden" role="status" aria-live="polite" aria-atomic="true">
    {{ __('exitThisPage') | safe }}
  </div>
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% include "partials/errorSummary.njk" %}
      <form class="form" action="{{ paths.LIVING_VISITING_WILL_DAYTIME_VISITS_HAPPEN }}" method="post" novalidate>
        <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
        {{
          govukRadios({
            name: formFields.WILL_DAYTIME_VISITS_HAPPEN,
            fieldset: {
              legend: {
                text: title,
                isPageHeading: true,
                classes: "govuk-fieldset__legend--l"
              }
            },
            items: [
              {
                value: "Yes",
                text: __('livingAndVisiting.willDaytimeVisitsHappen.yes')
              },
              {
                value: "No",
                text: __('livingAndVisiting.willDaytimeVisitsHappen.no')
              }
            ],
            value: formValues[formFields.WILL_DAYTIME_VISITS_HAPPEN],
            errorMessage: errors | findError(formFields.WILL_DAYTIME_VISITS_HAPPEN)
          })
        }}
        {{ govukButton({text: __('continue')}) }}
      </form>
    </div>
  </div>
{% endblock %}
