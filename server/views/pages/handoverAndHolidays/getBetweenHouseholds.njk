{% extends "partials/layout.njk" %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/textarea/macro.njk" import govukTextarea %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "macros/title.njk" import getTitle with context %}

{% block pageTitle %}
  {{
    getTitle(
      errors,
      titleIds.GET_BETWEEN_HOUSEHOLDS,
      [formFields.GET_BETWEEN_HOUSEHOLDS]
    )
  }}
{% endblock %}

{% block content %}
  {% include "partials/exitThisPage.njk" %}
  <div class="govuk-visually-hidden" role="status" aria-live="polite" aria-atomic="true">
    {{ __('exitThisPage') | safe }}
  </div>
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% include "partials/errorSummary.njk" %}
      <form class="form" action="{{ paths.HANDOVER_HOLIDAYS_GET_BETWEEN_HOUSEHOLDS }}" method="post" novalidate>
        <input type="hidden" name="_csrf" value="{{ csrfToken }}" />

        {% set describeArrangementHtml %}
          {{
            govukTextarea({
              name: formFields.GET_BETWEEN_HOUSEHOLDS_DESCRIBE_ARRANGEMENT,
              label: {
                text: __('describeArrangement')
              },
              value: formValues[formFields.GET_BETWEEN_HOUSEHOLDS_DESCRIBE_ARRANGEMENT],
              errorMessage: errors | findError(formFields.GET_BETWEEN_HOUSEHOLDS_DESCRIBE_ARRANGEMENT)
            })
          }}
        {% endset -%}

        {% set whoWillCollectHtml %}
          {{
            govukTextarea({
              name: formFields.GET_BETWEEN_HOUSEHOLDS_WHO_WILL_COLLECT,
              label: {
                text: __('handoverAndHolidays.getBetweenHouseholds.whoWillCollect', {children: childrenNames})
              },
              value: formValues[formFields.GET_BETWEEN_HOUSEHOLDS_WHO_WILL_COLLECT],
              errorMessage: errors | findError(formFields.GET_BETWEEN_HOUSEHOLDS_WHO_WILL_COLLECT)
            })
          }}
        {% endset -%}

        {{
          govukRadios({
            name: formFields.GET_BETWEEN_HOUSEHOLDS,
            fieldset: {
              legend: {
                text: __('handoverAndHolidays.getBetweenHouseholds.title', {children: childrenNames}),
                isPageHeading: true,
                classes: "govuk-fieldset__legend--l"
              }
            },
            items: [
              {
                value: "parent",
                text: __('handoverAndHolidays.getBetweenHouseholds.collectsTheChildren', {adult: initialAdultName, children: childrenNames})
              },
              {
                value: "otherParent",
                text: __('handoverAndHolidays.getBetweenHouseholds.collectsTheChildren', {adult: secondaryAdultName, children: childrenNames})
              },
              {
                value: "bothParents",
                text: __('handoverAndHolidays.getBetweenHouseholds.bothParentsCollect', {children: childrenNames})
              },
              {
                value: "someoneElse",
                text: __('handoverAndHolidays.getBetweenHouseholds.someoneElseCollects', {children: childrenNames}),
                conditional: {
                  html: whoWillCollectHtml
                }
              },
              {
                divider: __('or')
              },
              {
                value: "anotherArrangement",
                text: __('anotherArrangement'),
                conditional: {
                  html: describeArrangementHtml
                }
              }
            ],
            value: formValues[formFields.GET_BETWEEN_HOUSEHOLDS],
            errorMessage: errors | findError(formFields.GET_BETWEEN_HOUSEHOLDS)
          })
        }}
        <div class="govuk-!-margin-bottom-2"><button type="submit" formaction="{{ paths.HANDOVER_HOLIDAYS_GET_BETWEEN_HOUSEHOLDS_NOT_REQUIRED }}" class="govuk-link link-styled-button">{{ __('doNotNeedToDecideTransportBetweenHouseholds') }}</button></div>
        {{ govukButton({text: __('continue')}) }}
      </form>
    </div>
  </div>
{% endblock %}
