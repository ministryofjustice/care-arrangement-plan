{% set startYourOwnPlan = __('sharePlan.beforeYouStart.startYourOwnPlan') %}
<div class="cover-page">
  <div class="cover-masthead">
    <h1>{{ __('sharePlan.name') }}</h1>
    <p class="recipient-document">{{ __('sharePlan.recipientDocument') }}</p>
  </div>

  <div class="cover-columns">
    <div>
      <h2 id="preamble-heading">{{ __('sharePlan.beforeYouStart.title') }}</h2>
      <p class="cover-inset">{{ __('sharePlan.beforeYouStart.alert') }}</p>
      <ul>
        <li>
          <b>{{ __('sharePlan.beforeYouStart.options.voluntary.title') }}</b>
          {{ __('sharePlan.beforeYouStart.options.voluntary.text') }}
        </li>
        <li>
          <b>{{ __('sharePlan.beforeYouStart.options.legalDocument.title') }}</b>
          {{ __('sharePlan.beforeYouStart.options.legalDocument.text') }}
        </li>
        <li>
          <b>{{ __('sharePlan.beforeYouStart.options.informalAgreements.title') }}</b>
          {{ __('sharePlan.beforeYouStart.options.informalAgreements.text') }}
        </li>
        <li>
          <b>{{ __('sharePlan.beforeYouStart.options.courtOrder.title') }}</b>
          {{ __('sharePlan.beforeYouStart.options.courtOrder.text') }}
        </li>
      </ul>
    </div>

    <aside class="support-box">
      <p>{{ __('sharePlan.contact') | customUrlize | replace('">childarrangements@justice.gov.uk</a>', '">childarrangements@<br>justice.gov.uk</a>') | safe }}</p>
      <p>{{ __('sharePlan.unableToAssist') }}</p>
    </aside>
  </div>

  <p class="cover-plan">{{ __('sharePlan.beforeYouStart.startYourOwnPlan') | customUrlize | safe }}</p>

  <h3 class="cover-label">{{ __('sharePlan.beforeYouStart.getMoreInfo.title') }}</h3>
  <p>{{ __('sharePlan.beforeYouStart.getMoreInfo.intro') | safe }}</p>
  <ul>
    <li>{{ __('sharePlan.beforeYouStart.getMoreInfo.options.makingChildArrangements') | customUrlize | safe }}</li>
    <li>{{ __('sharePlan.beforeYouStart.getMoreInfo.options.findWays') | customUrlize | safe }}</li>
    <li>{{ __('sharePlan.beforeYouStart.getMoreInfo.options.childMaintenanceService') | customUrlize | safe }}</li>
  </ul>

  <p>{{ __('sharePlan.beforeYouStart.useThisDocument') }}</p>

  <h3 class="cover-label">{{ __('sharePlan.beforeYouStart.howToRespond.title') }}</h3>
  <ol>
    <li>{{ __('sharePlan.beforeYouStart.howToRespond.options.suggestedPlan') }}</li>
    <li>{{ __('sharePlan.beforeYouStart.howToRespond.options.markYourChoice') }}</li>
    <li>{{ __('sharePlan.beforeYouStart.howToRespond.options.addYourComments') }}</li>
    <li>{{ __('sharePlan.beforeYouStart.howToRespond.options.completedDocument') }}</li>
  </ol>

  <h3 class="govuk-heading-s">{{ __('sharePlan.suggested.title', {senderName: values.initialAdultName}) }}</h3>
  <p class="govuk-body">{{ __('sharePlan.suggested.intro', {senderName: values.initialAdultName, childrenNames: values.childrenNames}) | customUrlize | safe }}</p>

  <h4 class="govuk-heading-s">{{ __('sharePlan.suggested.howPlanCanHelp.title') }}</h4>
  <p class="govuk-body">{{ __('sharePlan.suggested.howPlanCanHelp.intro', {senderName: values.initialAdultName}) }}</p>
  <ul>
    <li>{{ __('sharePlan.suggested.howPlanCanHelp.options.cheaperAndQuicker')}}</li>
    <li>{{ __('sharePlan.suggested.howPlanCanHelp.options.betterOutcome')}}</li>
  </ul>

  <h4 class="govuk-heading-s">{{ __('sharePlan.suggested.yourPlanShould.title') }}</h4>
  <ul>
    <li>{{ __('sharePlan.suggested.yourPlanShould.options.welfareFirst')}}</li>
    <li>{{ __('sharePlan.suggested.yourPlanShould.options.reflectTheWishes')}}</li>
  </ul>

  <h4 class="govuk-heading-s">{{ __('sharePlan.yourSafety.title') }}</h4>
  <p class="govuk-body">{{ __('sharePlan.yourSafety.intro') }}</p>

  <h5 class="govuk-heading-s">{{ __('sharePlan.yourSafety.concerns') }}</h5>
  <p class="govuk-body">{{ __('sharePlan.yourSafety.feedback') | customUrlize | safe }}</p>

  <h4 class="govuk-heading-s">{{ __('sharePlan.decideNotToRespond.title') }}</h4>
  <ul>
    <li>{{ __('sharePlan.decideNotToRespond.options.noNegativeConsequences')}}</li>
    <li>{{ __('sharePlan.decideNotToRespond.options.noCourtImpact')}}</li>
    <li>{{ __('sharePlan.decideNotToRespond.options.noInformationSharing')}}</li>
  </ul>

  <h4 class="govuk-heading-s">{{ __('sharePlan.gettingHelpFindingChildArrangementOptions.title') }}</h4>
  <p class="govuk-body">{{ __('sharePlan.gettingHelpFindingChildArrangementOptions.intro') | customUrlize | safe }}</p>
  <p class="govuk-body">{{ __('sharePlan.gettingHelpFindingChildArrangementOptions.independentFamilyMediator') | customUrlize | safe }}</p>

  <h4 class="govuk-heading-s">{{ __('sharePlan.gettingHelpFindingChildArrangementOptions.notSuitable.title') }}</h4>
  <ul>
    <li>{{ __('sharePlan.gettingHelpFindingChildArrangementOptions.notSuitable.options.domesticAbuse')}}</li>
    <li>{{ __('sharePlan.gettingHelpFindingChildArrangementOptions.notSuitable.options.childAbduction')}}</li>
    <li>{{ __('sharePlan.gettingHelpFindingChildArrangementOptions.notSuitable.options.childAbuse')}}</li>
    <li>{{ __('sharePlan.gettingHelpFindingChildArrangementOptions.notSuitable.options.substanceMisuse')}}</li>
    <li>{{ __('sharePlan.gettingHelpFindingChildArrangementOptions.notSuitable.options.otherConcerns')}}</li>
  </ul>

  <h4 class="govuk-heading-s">{{ __('sharePlan.gettingHelpDomesticAbuse.title') }}</h4>
  <p class="govuk-body">{{ __('sharePlan.gettingHelpDomesticAbuse.intro') | customUrlize | safe }}</p>
  <p class="govuk-body">{{ __('sharePlan.gettingHelpDomesticAbuse.experiencedAbuse') | customUrlize | safe }}</p>
</div>
