PORT=8001
BUILD_NUMBER=1_0_0
GIT_REF=xxxxxxxxxxxxxxxxxxxxxxxx
GIT_BRANCH=xxxxxxxxxxxx
USE_HTTPS=false
STATIC_RESOURCE_CACHE_DURATION=1h
SESSION_SECRET=app-insecure-default-session
WEB_SESSION_TIMEOUT_IN_MINUTES=120
CACHE_ENABLED=false
CACHE_HOST=localhost
CACHE_PASSWORD=cache_password
CACHE_TLS_ENABLED=false
NODE_ENV=development
BETA_ACCESS_PASSWORDS=parent-planner,password2
USE_AUTH=true
# password (default) keeps the private-preview password page.
# one-login sends users through GOV.UK One Login. Locally this is the simulator.
AUTH_PROVIDER=password
# Optional when AUTH_PROVIDER=one-login and the issuer is the local simulator.
# ONE_LOGIN_ISSUER=http://localhost:3000/
# ONE_LOGIN_CLIENT_ID=HGIOgho9HIRhgoepdIOPFdIUWgewi0jw
# ONE_LOGIN_REDIRECT_URL=http://localhost:8001/oidc/authorization-code/callback
# ONE_LOGIN_POST_LOGOUT_REDIRECT_URL=http://localhost:8001/signed-out
# ONE_LOGIN_SCOPES=openid,email
# ONE_LOGIN_VTR=Cl.Cm
# Required for any issuer other than the local simulator. Never use the simulator key outside local development.
# ONE_LOGIN_PRIVATE_KEY=
INCLUDE_WELSH_LANGUAGE=true
FEEDBACK_URL=https://feedback.example.com
CONTACT_EMAIL=test@example.com
PREVIEW_END=2025-04-30T23:59:59
LOG_LEVEL=debug
HASH_SECRET=local-dev-secret
SERVICE_URL=http://localhost:3001
ENABLE_ANALYTICS=false
GA4_ID=test-ga-id
